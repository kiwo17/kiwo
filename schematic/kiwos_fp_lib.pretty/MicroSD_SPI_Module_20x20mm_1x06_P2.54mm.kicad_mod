(footprint "MicroSD_SPI_Module_20x20mm_1x06_P2.54mm"
  (version 20240108)
  (generator "pcbnew")
  (layer "F.Cu")
  (descr "Approximate footprint for 20x20mm mini microSD SPI module, 1x06 pins at 2.54mm pitch. Verify dimensions against the physical module before fabrication.")
  (tags "microSD TF SPI module breakout")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 -11.2) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "MicroSD_SPI_Module_20x20" (at 0 11.2) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15))))
  ; Assumed 20 x 20 mm module outline
  (fp_rect (start -10 -10) (end 10 10)
    (stroke (width 0.12) (type default)) (fill none) (layer "F.Fab"))
  (fp_rect (start -10 -10) (end 10 10)
    (stroke (width 0.12) (type default)) (fill none) (layer "F.SilkS"))
  ; Six header holes along the left edge, 2.54 mm pitch.
  ; Pad 1 is 3V3; pad 6 is GND.
  (pad "1" thru_hole rect (at -8.5 -6.35) (size 1.8 1.8) (drill 1.0)
    (layers "*.Cu" "*.Mask")
    (pinfunction "3V3") (pintype "power_in"))
  (pad "2" thru_hole circle (at -8.5 -3.81) (size 1.8 1.8) (drill 1.0)
    (layers "*.Cu" "*.Mask")
    (pinfunction "CS") (pintype "input"))
  (pad "3" thru_hole circle (at -8.5 -1.27) (size 1.8 1.8) (drill 1.0)
    (layers "*.Cu" "*.Mask")
    (pinfunction "MOSI") (pintype "input"))
  (pad "4" thru_hole circle (at -8.5 1.27) (size 1.8 1.8) (drill 1.0)
    (layers "*.Cu" "*.Mask")
    (pinfunction "CLK") (pintype "input"))
  (pad "5" thru_hole circle (at -8.5 3.81) (size 1.8 1.8) (drill 1.0)
    (layers "*.Cu" "*.Mask")
    (pinfunction "MISO") (pintype "output"))
  (pad "6" thru_hole circle (at -8.5 6.35) (size 1.8 1.8) (drill 1.0)
    (layers "*.Cu" "*.Mask")
    (pinfunction "GND") (pintype "power_in"))
  ; Approximate large mounting holes, based on the supplied photo.
  (pad "" np_thru_hole circle (at -2.8 -8.5) (size 2.2 2.2) (drill 2.2)
    (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at -2.8 8.5) (size 2.2 2.2) (drill 2.2)
    (layers "*.Cu" "*.Mask"))
)
